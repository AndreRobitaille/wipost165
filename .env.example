# Rails does not automatically load this file. Export variables in your shell.
# Development uses the publisher by default. Set 1 only for the labelled mockup.
PUBLIC_SITE_PREVIEW=0
# V1 excludes people/stories/portraits. Use v2 to review the preserved full design.
PUBLIC_SITE_EDITION=v1
PUBLISHER_ORIGIN=https://members.wipost165.org
# Set legion_post_tools.website_token in each environment's encrypted credentials.
# Optional local override; set securely, never commit an actual token here.
# PUBLISHER_TOKEN=
# Approved public defaults; an explicit blank hides the corresponding channel.
PUBLIC_CONTACT_EMAIL=wipost165@gmail.com
PUBLIC_CONTACT_PHONE="(920) 860-7478"
# Deployment only: use this app's own generated secret, never the member app's key.
POST165_PUBLIC_SECRET_KEY_BASE=
KAMAL_REGISTRY_PASSWORD=

# Production holding page; deployment config controls the released value.
PUBLIC_SITE_COMING_SOON=0
# Production-only indexing and page-specific sharing; keep 0 during preparation.
PUBLIC_SITE_LAUNCH_READY=0
