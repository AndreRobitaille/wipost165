#!/usr/bin/env bash

set -Eeuo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly APP_ROOT
readonly PROD_HOST="178.156.250.235"
readonly PROD_SERVICE="legion_post_165_wi_public"
readonly TUNNEL_PORT="${RELEASE_TUNNEL_PORT:-22222}"
readonly PROD_URL="https://wipost165.org"
readonly MEMBERS_URL="https://members.wipost165.org"
readonly COHOSTED_URL="https://tworiversmatters.com"
readonly SSH_CONFIG="${RELEASE_SSH_CONFIG:-$HOME/.ssh/config}"
SYSTEM_SSH="$(command -v ssh)"
readonly SYSTEM_SSH

release_temp_config=""
release_temp_dir=""
release_control_path=""

cd "$APP_ROOT"

usage() {
  echo "Usage: bin/release check|push|session" >&2
  exit 64
}

fail() {
  echo "release: $*" >&2
  exit 1
}

cleanup_release() {
  if [[ -n "$release_control_path" ]]; then
    "$SYSTEM_SSH" -F "$SSH_CONFIG" -S "$release_control_path" -O exit "$PROD_HOST" >/dev/null 2>&1 || true
  fi
  [[ -z "$release_temp_dir" ]] || rm -rf -- "$release_temp_dir"
}

current_branch() {
  git symbolic-ref --quiet --short HEAD || fail "detached HEAD cannot be released"
}

remote_head() {
  local branch="$1"
  PATH="${RELEASE_ORIGINAL_PATH:-$PATH}" git ls-remote --heads origin "refs/heads/$branch" | awk 'NR == 1 { print $1 }'
}

assert_remote_matches_head() {
  local branch head remote
  branch="$(current_branch)"
  head="$(git rev-parse HEAD)"
  remote="$(remote_head "$branch")"

  [[ -n "$remote" ]] || fail "origin has no branch named $branch; run bin/release push first"
  [[ "$remote" == "$head" ]] || fail "origin/$branch is $remote, but local HEAD is $head; run bin/release push first"
}

assert_clean_worktree() {
  git diff --quiet || fail "working tree has unstaged changes; deploy only a reviewed commit"
  git diff --cached --quiet || fail "index has staged but uncommitted changes; deploy only a reviewed commit"
  [[ -z "$(git ls-files --others --exclude-standard)" ]] || fail "working tree has untracked files; deploy only a reviewed commit"
}

push_head() {
  local branch head remote
  branch="$(current_branch)"
  head="$(git rev-parse HEAD)"

  echo "Pushing $head to origin/$branch..."
  git push --set-upstream origin "HEAD:refs/heads/$branch"

  remote="$(remote_head "$branch")"
  [[ "$remote" == "$head" ]] || fail "GitHub did not resolve origin/$branch to $head after push"
  echo "GitHub verified at $head."
}

effective_ssh_value() {
  local key="$1"
  ssh -F "$SSH_CONFIG" -G "$PROD_HOST" 2>/dev/null | awk -v key="$key" '$1 == key { $1 = ""; sub(/^ /, ""); print; exit }'
}

prepare_kamal_config() {
  local output="$1" control_path="$2" identity_file="$3"

  ruby -ryaml -rshellwords -e '
    source, output, host, control_path, identity_file, ssh_config, tunnel_port = ARGV
    config = YAML.safe_load_file(source, aliases: true)
    config["ssh"] = {
      "user" => "root",
      "keys" => [identity_file],
      "keys_only" => true,
      "config" => false,
      "proxy_command" => "socat - TCP:127.0.0.1:#{tunnel_port}"
    }
    builder = config["builder"] ||= {}
    builder["remote"] = "ssh://root@#{host}"
    builder["local"] = false
    File.write(output, YAML.dump(config))
  ' config/deploy.yml "$output" "$PROD_HOST" "$control_path" "$identity_file" "$SSH_CONFIG" "$TUNNEL_PORT"
}

assert_http_status() {
  local url="$1" expected="$2" attempts="${3:-10}" status=""

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    status="$(curl --connect-timeout 10 --max-time 20 --resolve "wipost165.org:443:$PROD_HOST" --resolve "www.wipost165.org:443:$PROD_HOST" --silent --show-error --output /dev/null --write-out '%{http_code}' "$url" || true)"
    if [[ "$status" == "$expected" ]]; then
      echo "$url -> $status"
      return 0
    fi
    sleep 2
  done

  fail "$url returned $status; expected $expected"
}

with_production_connection() {
  [[ -z "${RELEASE_CONTROL_PATH:-}" ]] || fail "already inside a release session; use its release_* commands"
  local control_path identity_file

  [[ -n "${KAMAL_REGISTRY_PASSWORD:-}" ]] || fail "export KAMAL_REGISTRY_PASSWORD"
  [[ -n "${POST165_PUBLIC_SECRET_KEY_BASE:-}" ]] || fail "export a unique POST165_PUBLIC_SECRET_KEY_BASE"
  [[ -r "$SSH_CONFIG" ]] || fail "missing readable SSH config at $SSH_CONFIG"

  control_path=""
  identity_file="$(effective_ssh_value identityfile)"
  [[ -n "$identity_file" ]] || fail "SSH config does not define IdentityFile for $PROD_HOST"
  identity_file="${identity_file/#\~/$HOME}"
  [[ -r "$identity_file" ]] || fail "configured identity file is not readable: $identity_file"

  command -v socat >/dev/null || fail "socat is required for the persistent tunnel"
  ruby -rsocket -e 'TCPServer.new("127.0.0.1", Integer(ARGV[0])).close' "$TUNNEL_PORT" || fail "tunnel port is occupied; preserve its owner and choose another RELEASE_TUNNEL_PORT"

  release_temp_dir="$(mktemp -d /tmp/post165-public-release.XXXXXX)"
  release_control_path="$release_temp_dir/ssh.sock"
  control_path="$release_control_path"
  release_temp_config="$release_temp_dir/deploy.yml"
  trap cleanup_release EXIT
  echo "Starting an owned public-site SSH control master..."
  timeout --signal=TERM 45 "$SYSTEM_SSH" -F "$SSH_CONFIG" -S "$control_path" -o ControlMaster=yes -o ControlPersist=yes -o BatchMode=yes -o ConnectTimeout=15 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -L "127.0.0.1:$TUNNEL_PORT:127.0.0.1:22" -Nf "$PROD_HOST"
  "$SYSTEM_SSH" -F "$SSH_CONFIG" -S "$control_path" -O check "$PROD_HOST"

  # Docker's remote builder invokes OpenSSH itself; force it through our socket too.
  mkdir "$release_temp_dir/bin"
  export RELEASE_SYSTEM_SSH="$SYSTEM_SSH" RELEASE_CONTROL_PATH="$control_path" RELEASE_CONFIG_PATH="$SSH_CONFIG"
  export RELEASE_IDENTITY_FILE="$identity_file" RELEASE_TUNNEL_PORT="$TUNNEL_PORT"
  cat > "$release_temp_dir/bin/ssh" <<'WRAPPER'
#!/usr/bin/env bash
exec "$RELEASE_SYSTEM_SSH" -F /dev/null -o BatchMode=yes -o ConnectTimeout=20 -o IdentityAgent=none -o IdentitiesOnly=yes -o "ProxyCommand=socat - TCP:127.0.0.1:$RELEASE_TUNNEL_PORT" -i "$RELEASE_IDENTITY_FILE" -l root "$@"
WRAPPER
  chmod 700 "$release_temp_dir/bin/ssh"
  export RELEASE_ORIGINAL_PATH="$PATH"
  export PATH="$release_temp_dir/bin:$PATH"
  export DOCKER_HOST="ssh://root@$PROD_HOST"
  unset DOCKER_CONTEXT BUILDX_BUILDER

  # Net::SSH otherwise probes the desktop signing agent despite keys_only.
  unset SSH_AUTH_SOCK
  prepare_kamal_config "$release_temp_config" "$control_path" "$identity_file"
  export APP_ROOT PROD_HOST PROD_SERVICE PROD_URL MEMBERS_URL COHOSTED_URL SSH_CONFIG SYSTEM_SSH
  export release_temp_config release_temp_dir release_control_path
  export -f fail current_branch remote_head assert_remote_matches_head assert_clean_worktree
  export -f assert_http_status release_ssh release_preflight release_run release_setup release_deploy release_verify
  cat > "$release_temp_dir/session.rc" <<'SESSION'
PS1='post165-release> '
echo "One tunnel is open. Keep this shell for the entire operation."
echo "Commands: release_setup, release_deploy, release_verify, release_ssh <command>. Exit only when finished."
if ! release_preflight; then
  echo "Preflight failed. Keep this session open for diagnosis; do not start another tunnel."
fi
SESSION
  # The parent owns cleanup. A failed build/deploy returns to this same shell.
  bash --noprofile --rcfile "$release_temp_dir/session.rc" -i
}

release_ssh() {
  "$SYSTEM_SSH" -F "$SSH_CONFIG" -S "$release_control_path" -O check "$PROD_HOST" >/dev/null 2>&1 || {
    echo "Release tunnel is unavailable; no direct fallback or automatic reconnect." >&2
    return 1
  }
  ssh -o BatchMode=yes "$PROD_HOST" "$@"
}

release_preflight() {
  release_ssh 'hostname; docker --version' || return
  bin/kamal config -c "$release_temp_config" >/dev/null || return
  bin/kamal server exec hostname -c "$release_temp_config" || return
  release_ssh '{ docker ps --filter label=service=legion_post_165_wi_tools --format "{{.ID}} {{.Names}}"; docker ps --filter label=service=two_rivers_reporter --format "{{.ID}} {{.Names}}"; } | sort' > "$release_temp_dir/protected-before.txt" || return
  [[ -s "$release_temp_dir/protected-before.txt" ]] || return 1
  release_ssh 'docker exec kamal-proxy kamal-proxy list' || return
  export RELEASE_PREFLIGHT_OK=1
  echo "Transport and protected-service baseline verified. Keep this tunnel open."
}

release_run() (
  set -Eeuo pipefail
  [[ "${RELEASE_PREFLIGHT_OK:-}" == "1" ]] || fail "run release_preflight successfully in this session first"
  assert_clean_worktree
  assert_remote_matches_head
  release_ssh true
  if ruby -ryaml -e 'exit(YAML.safe_load_file("config/deploy.yml").dig("env", "clear", "PUBLIC_SITE_COMING_SOON") == "1" ? 0 : 1)'; then
    echo "Coming-soon release: publishing feed is intentionally unused."
  else
    bin/publisher-check
  fi
  bin/kamal "$1" -c "$release_temp_config"
  release_verify
)

release_setup() { release_run setup; }
release_deploy() { release_run deploy; }

release_verify() (
  set -Eeuo pipefail
  local head container_names
  head="$(git rev-parse HEAD)"
  container_names="$(release_ssh "docker ps --filter label=service=$PROD_SERVICE --filter label=role=web --format '{{.Names}}'")"
  grep -Fxq "$PROD_SERVICE-web-$head" <<< "$container_names" || fail "public container does not match $head"
  release_ssh '{ docker ps --filter label=service=legion_post_165_wi_tools --format "{{.ID}} {{.Names}}"; docker ps --filter label=service=two_rivers_reporter --format "{{.ID}} {{.Names}}"; } | sort' > "$release_temp_dir/protected-after.txt"
  diff -u "$release_temp_dir/protected-before.txt" "$release_temp_dir/protected-after.txt" || fail "protected service containers changed"
  release_ssh 'docker exec kamal-proxy kamal-proxy list'
  assert_http_status "$PROD_URL/up" 200
  assert_http_status "$PROD_URL/" 200
  assert_http_status "https://www.wipost165.org/up" 200
  assert_http_status "https://www.wipost165.org/" 200
  assert_http_status "$MEMBERS_URL/up" 200
  assert_http_status "$MEMBERS_URL/session/new" 200
  assert_http_status "$COHOSTED_URL/" 200
  echo "Production verified at $head. Tunnel remains open for final checks; exit when finished."
)

local_check() {
  bash -n bin/release
  ruby -ryaml -e 'c=YAML.safe_load_file("config/deploy.yml"); abort "wrong service" unless c["service"] == "legion_post_165_wi_public"; abort "wrong hosts" unless c.dig("proxy", "hosts").sort == %w[wipost165.org www.wipost165.org]; abort "TLS required" unless c.dig("proxy", "ssl") == true'
  echo "Local release checks passed. No SSH connection opened. Use one bin/release session for all production work."
}

command="${1:-}"
[[ $# -eq 1 ]] || usage

case "$command" in
  check) local_check ;;
  push) push_head ;;
  session) with_production_connection ;;
  setup|deploy|push-deploy)
    fail "standalone production commands are disabled: use bin/release session, then release_setup or release_deploy inside that same shell"
    ;;
  *) usage ;;
esac
