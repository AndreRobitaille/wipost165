<section aria-labelledby="event-title">
  <p class="eyebrow"><%= preview_mode? ? "EXAMPLE INVITATION · NOT SCHEDULED" : "AT POST 165" %></p>
  <h1 id="event-title"><%= @event.title %></h1>
  <% if @event.cancelled? %><p class="event-notice" role="status">This event has been cancelled.</p><% elsif @event.past? %><p class="event-notice">This event has already taken place. <%= link_to "See upcoming events", events_path(person_context) %>.</p><% end %>
  <div class="body-copy compact"><%= simple_format(h(@event.description), {}, sanitize: false) %></div>
  <dl class="event-details">
    <div><dt>When</dt><dd><% if @event.starts_at %><%= time_tag @event.starts_at, event_time(@event) %><% else %><%= event_time(@event) %><% end %><% if @event.ends_at %><small>Until <%= @event.ends_at.strftime("%b %-d, %-I:%M %p %Z") %></small><% end %></dd></div>
    <div><dt>Where</dt><dd><%= @event.location_name.presence || "To be confirmed" %></dd></div>
    <div><dt>Guests &amp; children</dt><dd>Please check with the Post before making plans.</dd></div>
  </dl>
  <% unless @event.cancelled? || @event.past? %><%= render "recognition" %><%= link_to "Thinking of coming? →", visit_path(person_context), class: "main-action" %><% end %>
</section>
