<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= render "public_site/metadata" %>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; padding: 32px 24px; background: #fff; color: #183043; font: 18px/1.6 system-ui, sans-serif; }
      main { width: 100%; max-width: 640px; border-top: 5px solid #00467f; padding-top: 32px; }
      .post { margin: 0; color: #00467f; font-weight: 650; }
      .location { margin: 4px 0 36px; color: #4a5863; font-size: 16px; }
      h1 { margin: 0 0 16px; font: bold clamp(36px, 7vw, 52px)/1.15 Georgia, serif; letter-spacing: -.02em; }
      p { margin: 0 0 24px; }
      a { display: inline-block; padding: 10px 0; color: #00467f; text-underline-offset: 5px; }
      a:focus-visible { outline: 3px solid #00467f; outline-offset: 5px; }
    </style>
  </head>
  <body>
    <main>
      <p class="post">Robert E. Burns American Legion Post 165</p>
      <p class="location">Two Rivers, Wisconsin</p>
      <h1>Website coming soon.</h1>
      <p>We’re preparing our new website. Please check back soon.</p>
      <a href="https://members.wipost165.org/">Go to the members site</a>
    </main>
  </body>
</html>
