<section aria-labelledby="contact-title">
  <p class="eyebrow">A SIMPLE FIRST STEP</p><h1 id="contact-title">Say hello.</h1>
  <p class="body-copy">Questions about coming along, membership, or the Post? Start here.</p>
  <% if public_contact_available? %>
    <% if public_contact_email %><p><%= mail_to public_contact_email, "Email the Post →", subject: first_visit_subject, class: "main-action" %></p><p class="contact-detail"><%= public_contact_email %></p><% end %>
    <% if public_contact_phone %><p><%= link_to "Call #{public_contact_phone}", public_phone_href, class: "text-action" %></p><% end %>
    <p class="small-note">The Post is run by volunteers. Please allow time for a reply.</p>
  <% else %>
    <p class="contact-pending">Email and phone contact details aren’t available here. You can write to the Post at the mailing address below.</p>
    <p class="quiet-link"><%= link_to "See published event details →", events_path(person_context) %></p>
  <% end %>
  <h2>Mailing address</h2>
  <p class="body-copy compact">American Legion Post 165<br>PO Box 11<br>Two Rivers, WI 54241</p>
  <p class="quiet-link"><%= link_to "Meeting location and first visits →", visit_path(person_context) %></p>
  <% if @remembered_person %><div class="conversation"><span class="eyebrow">SOMETHING YOU COULD ASK</span><p>“I read <%= @remembered_person.name %>’s introduction. Who could I look for on my first visit?”</p></div><% end %>
</section>
