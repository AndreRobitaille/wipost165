<section aria-labelledby="events-title">
  <p class="eyebrow"><%= public_site_v1? ? "PUBLIC OCCASIONS" : "AROUND THE TABLE" %></p><h1 id="events-title">Come on by.</h1>
  <p class="calendar-window">Public occasions over the next three months.</p>
  <% if @events.any? %>
    <% @events.each do |event| %>
      <%= link_to event_path(event, **person_context), class: "occasion" do %>
        <span class="occasion-date"><%= event.date ? event.date.strftime("%b").upcase : "DATE" %><br><strong><%= event.date ? event.date.day : "TBC" %></strong></span>
        <span class="occasion-copy"><% if preview_mode? %><span class="sample-tag">EXAMPLE OCCASION</span><% end %><% if event.cancelled? %><span class="cancelled-tag">CANCELLED</span><% end %><strong><%= event.title %></strong><span class="occasion-time"><%= event_time(event) %></span><span><%= event.location_name.presence || "Location to be confirmed" %></span></span><span class="occasion-arrow" aria-hidden="true">↗</span>
      <% end %>
    <% end %>
    <% if preview_mode? %><p class="small-note">This sample invitation is not a scheduled event.</p><% end %>
  <% elsif @content.events_unavailable %>
    <p class="body-copy">The public calendar is temporarily unavailable.</p>
    <p class="body-copy compact">Please check back shortly before making plans.</p>
  <% else %>
    <p class="body-copy">There aren’t any upcoming public dates listed right now.</p>
    <p class="body-copy compact">New dates will appear here when they’re available.</p>
  <% end %>
  <p class="quiet-link"><%= link_to "Plan your first visit →", visit_path(person_context) %></p>
  <% if public_contact_available? %><p class="quiet-link"><%= link_to "Ask the Post about visiting →", contact_path(person_context) %></p><% end %>
</section>
