<title><%= public_document_title %></title>
<%= tag.meta name: "description", content: public_page_description %>
<% unless public_page_indexable? %>
  <meta name="robots" content="noindex, nofollow, nosnippet, noimageindex">
<% end %>
<%= tag.link rel: "canonical", href: public_canonical_url %>
<%= render "public_site/icons" %>
<% if public_page_indexable? %>
  <%= tag.meta property: "og:title", content: public_document_title %>
  <%= tag.meta property: "og:description", content: public_page_description %>
  <%= tag.meta property: "og:url", content: public_canonical_url %>
  <meta property="og:type" content="website">
  <%= tag.meta property: "og:site_name", content: PublicSiteHelper::DOCUMENT_TITLE %>
  <meta property="og:locale" content="en_US">
  <%= tag.meta property: "og:image", content: PublicSiteHelper::SHARING_IMAGE_URL %>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <%= tag.meta property: "og:image:alt", content: PublicSiteHelper::SHARING_IMAGE_ALT %>
  <meta name="twitter:card" content="summary_large_image">
  <%= tag.meta name: "twitter:title", content: public_document_title %>
  <%= tag.meta name: "twitter:description", content: public_page_description %>
  <%= tag.meta name: "twitter:image", content: PublicSiteHelper::SHARING_IMAGE_URL %>
  <%= tag.meta name: "twitter:image:alt", content: PublicSiteHelper::SHARING_IMAGE_ALT %>
  <% if action_name == "home" %>
    <script type="application/ld+json"><%= raw json_escape(public_website_schema.to_json) %></script>
  <% end %>
<% end %>
<%= public_google_tag %>
