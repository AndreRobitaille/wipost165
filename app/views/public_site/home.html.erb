<section aria-labelledby="welcome-title">
  <p class="eyebrow">VETERANS. NEIGHBORS. GOOD COMPANY.</p>
  <h1 id="welcome-title">In good<br><span>company.</span></h1>
  <p class="welcome-copy"><%= @people.any? ? "A few faces to know before you walk in." : "Get to know your local American Legion Post." %></p>
  <% if @people.any? %><%= link_to "Meet someone ↗", person_path(@people.first), class: "main-action" %><% else %><%= link_to "Plan a first visit ↗", visit_path, class: "main-action" %><% end %>
  <p class="quiet-link"><%= link_to "Or see what’s coming up →", events_path %></p>
</section>
